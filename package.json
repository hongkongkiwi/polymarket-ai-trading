{
  "name": "@clawnify/polymarket-ai-trading",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 execute pm-ai-trading-db --local --file=src/server/schema.sql && wrangler d1 migrations apply pm-ai-trading-db --local && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "for file in tests/*.test.ts; do node tests/run.mjs \"$(basename \"$file\")\" || exit $?; done"
  },
  "dependencies": {
    "@clawnify/db": "^0.4.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
